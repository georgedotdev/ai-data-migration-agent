# Copy to .env. These defaults match docker-compose.yml.

# PostgreSQL source
PG_HOST=127.0.0.1
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=postgres
PG_DATABASE=migration_db
# Hosted Postgres (Neon, Supabase): PG_SSLMODE=require
# PG_SSLMODE=

# MySQL target
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=rootpassword
MYSQL_DATABASE=migration_db
# Non-local MySQL hosts always use TLS with certificate verification.
# MYSQL_SSL_CA=/path/to/ca.pem        # custom CA bundle file if the provider needs one
# MYSQL_SSL_CA_PEM="-----BEGIN CERTIFICATE-----..."   # or the CA as text

# Optional: only the Agentic tab uses an LLM; the migration demo is fully deterministic.
GROQ_API_KEY=
GOOGLE_API_KEY=
OPENAI_API_KEY=
# Override models if a provider retires the defaults
# GROQ_MODEL=openai/gpt-oss-120b
# GEMINI_MODEL=gemini-3.8-flash
# OPENAI_MODEL=gpt-4o
