# PostgreSQL Source Database Credentials
PG_HOST=your-postgres-host.example.com
PG_PORT=5432
PG_USER=your_postgres_user
PG_PASSWORD=your_postgres_password
PG_DATABASE=your_postgres_database

# MySQL Target Database Credentials
MYSQL_HOST=your-mysql-host.example.com
MYSQL_PORT=3306
MYSQL_USER=your_mysql_user
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=your_mysql_database

# Optional AI / LLM Keys (Not required for deterministic demo)
GOOGLE_API_KEY=
OPENAI_API_KEY=
