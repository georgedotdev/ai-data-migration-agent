# Streamlit Community Cloud: paste this into App settings -> Secrets (fill in real values).
# Root-level keys are exposed as environment variables, which is what the app reads.

PG_HOST = "ep-xxxx.region.aws.neon.tech"
PG_PORT = "5432"
PG_USER = "neondb_owner"
PG_PASSWORD = "..."
PG_DATABASE = "neondb"
PG_SSLMODE = "require"

# Use a real MySQL 8 (e.g. Aiven free tier). TiDB does not enforce CHECK constraints by default.
MYSQL_HOST = "mysql-xxxx.aivencloud.com"
MYSQL_PORT = "12345"
MYSQL_USER = "avnadmin"
MYSQL_PASSWORD = "..."
MYSQL_DATABASE = "defaultdb"
# Aiven signs with its own CA: paste the CA certificate from the service overview page
MYSQL_SSL_CA_PEM = """-----BEGIN CERTIFICATE-----
...
-----END CERTIFICATE-----"""

# Optional
GROQ_API_KEY = ""
